{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPulse EvaluationManifest v1.2 (recommendation)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_kind", "eval_split", "split_sha256", "protocol_sha256", "ground_truth_sha256", "protocol_version", "metrics", "counts", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "run_id": {"type": "string", "minLength": 1},
    "model_kind": {"enum": ["Pop", "BPR"]},
    "eval_split": {"enum": ["validation", "test"]},
    "split_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ground_truth_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ndcg_at_10", "recall_at_10", "coverage_at_10"],
      "properties": {
        "ndcg_at_10": {"type": "number", "minimum": 0, "maximum": 1},
        "recall_at_10": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage_at_10": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_user_count", "no_relevance_user_count", "fallback_user_count", "eligible_item_count", "excluded_seen_relevance_count", "excluded_cold_relevance_count"],
      "properties": {
        "valid_user_count": {"type": "integer", "minimum": 1},
        "no_relevance_user_count": {"type": "integer", "minimum": 0},
        "fallback_user_count": {"type": "integer", "minimum": 0},
        "eligible_item_count": {"type": "integer", "minimum": 1},
        "excluded_seen_relevance_count": {"type": "integer", "minimum": 0},
        "excluded_cold_relevance_count": {"type": "integer", "minimum": 0}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
