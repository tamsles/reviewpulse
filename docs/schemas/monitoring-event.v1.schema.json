{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecommendationEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "request_id",
    "time_utc",
    "loaded_release_id",
    "source",
    "user_key_hash",
    "top_k",
    "candidate_count",
    "returned_item_count",
    "fallback_used",
    "fusion_used",
    "latency_ms",
    "http_status",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "loaded_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "enum": [
        "api",
        "synthetic_demo"
      ]
    },
    "user_key_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "top_k": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "returned_item_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fallback_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "fusion_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
