{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPulse NormalizedInteraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_id",
    "user_id",
    "item_id",
    "event_time_utc",
    "rating",
    "is_positive",
    "source",
    "source_snapshot_id"
  ],
  "properties": {
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "event_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "is_positive": {
      "type": "boolean"
    },
    "source": {
      "const": "amazon_review"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
